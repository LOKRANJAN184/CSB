# Copy this file to .env for local development.  NEVER commit .env.
# On Vercel, set these in Project → Settings → Environment Variables.

# MongoDB connection string (Atlas: Database → Connect → Drivers)
MONGODB_URI=mongodb://127.0.0.1:27017/csb_bakery

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional
# OWNER_SESSION_HOURS=5
# MANAGER_SESSION_HOURS=1
# GITHUB_REPO=LOKRANJAN184/CSB

# Only used the very first time, when the database is empty:
# SEED_OWNER_LOGINS=9876543210:1234,9123456780:5678
# SEED_MANAGER_PIN=4321
