{
  "name": "chendurar-sweets-bakery",
  "version": "2.0.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/",
    "build": "node scripts/sync-version.js",
    "cap:sync": "node scripts/sync-version.js && npx cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "release": "node scripts/release.js"
  },
  "description": "Daily sales tally, staff attendance and salary app for Chendurar Sweets & Bakery",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "multer": "^2.5.0",
    "pdfkit": "^0.14.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
